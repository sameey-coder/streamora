# STREAMORA environment variables
# Copy this file to .env in the project root.
# Vite loads VITE_* variables from the root .env for frontend code.
# The backend server (server/index.js) also loads the root .env via dotenv.
# Do NOT commit real credentials.

# --- Frontend (Vite; exposed to browser, VITE_ prefix required) ---
VITE_TMDB_API_KEY=your_tmdb_api_key_here
VITE_API_BASE_URL=http://localhost:5000

# --- Backend (server-only; never use VITE_ prefix) ---
FLW_PUBLIC_KEY=FLWPUBK_TEST_your_flutterwave_public_key_here
FLW_SECRET_KEY=FLWSECK_TEST_your_flutterwave_secret_key_here
FRONTEND_URL=http://localhost:5173
PORT=5000

# Demo-only admin reset protection for POST /api/admin/reset-test-data.
# Use a strong random placeholder value locally; not production-grade auth.
ADMIN_RESET_TOKEN=your_strong_random_admin_reset_token_here

# Optional reference: backend reads root .env by default (see server/index.js).
# If you create server/.env, ensure your process loads it intentionally.
# Do NOT commit real credentials.

FLW_PUBLIC_KEY=FLWPUBK_TEST_your_flutterwave_public_key_here
FLW_SECRET_KEY=FLWSECK_TEST_your_flutterwave_secret_key_here
FRONTEND_URL=http://localhost:5173
PORT=5000
ADMIN_RESET_TOKEN=your_strong_random_admin_reset_token_here
